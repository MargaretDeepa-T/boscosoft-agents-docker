GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Required to call any /api/v1/* endpoint (sent as the X-API-Key header).
# Health endpoints (/health/live, /health/ready) are never protected.
AGENT_API_KEY=change-me-to-a-long-random-secret

# Backs estimate-drift protection (server-side memory of prior
# validation rounds per task_id). Optional in the sense that the service
# starts and validates normally without it - see "fail open" in
# README.md - but drift protection is disabled until it's reachable.
# Under docker-compose this is overridden to redis://redis:6379/0
# automatically; only needed here for running main.py directly.
REDIS_URL=redis://localhost:6379/0

# --- optional tuning (all have safe defaults if omitted) ---

# How many backlog tasks are validated in parallel (shared across all
# jobs and the single-task endpoint).
BULK_MAX_WORKERS=3

# Client-side ceiling on concurrent Groq calls, independent of worker count.
GROQ_MAX_CONCURRENT_REQUESTS=3

# Sliding 60s-window cap on Groq requests, independent of concurrency.
GROQ_MAX_REQUESTS_PER_MINUTE=60

GROQ_REQUEST_TIMEOUT_SECONDS=60

# Retries within a single validation/repair/correction call sequence.
MAX_LLM_RETRIES=3

# Hard ceiling on total Groq calls for one task: initial attempts +
# decision repair + estimate correction, combined. Never exceeded.
MAX_LLM_CALLS_PER_TASK=6

RETRY_BACKOFF_SECONDS=1.5

# Request validation limits (oversized requests are rejected with 422).
MAX_DESCRIPTION_CHARS=4000
MAX_TITLE_CHARS=300
MAX_TASKS_PER_JOB=200
MAX_HISTORICAL_TASKS=5

# How long a finished bulk job's result stays in memory before it is
# eligible for cleanup on the next job creation.
JOB_RETENTION_SECONDS=86400

# TTL (seconds) on a task's estimate-drift history in Redis; refreshed on
# every validation round, so an actively-revised task never expires.
TASK_ESTIMATION_RETENTION_SECONDS=86400

# How long an unchanged task's validation result is reused instead of
# re-calling Groq (keyed on a hash of the task's own content, so any real
# edit invalidates the cache automatically). Short by design: this is for
# "clicked Verify twice without changing anything," not long-term storage.
VALIDATION_CACHE_TTL_SECONDS=600

# How long to wait for in-flight jobs to finish on shutdown before the
# executor is forced closed.
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
