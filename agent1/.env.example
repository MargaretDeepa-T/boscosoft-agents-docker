# ---- required ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local dev only. Under docker-compose this is overridden to
# redis://redis:6379/0 automatically. If Redis is unreachable the service
# still runs, but falls back to an in-memory cache (results reset on restart).
REDIS_URL=redis://localhost:6379/0

# ---- optional tuning (defaults shown) ----

# Tasks validated in parallel per bulk request.
BULK_MAX_WORKERS=3
# Ceiling on simultaneous Groq calls.
GROQ_MAX_CONCURRENT_REQUESTS=3
GROQ_REQUEST_TIMEOUT_SECONDS=60
MAX_LLM_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5

# gpt-oss models: low | medium | high
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2000
GROQ_COMPLETION_TOKENS_RETRY_STEP=500

# Longer descriptions are truncated in the prompt only.
MAX_DESCRIPTION_CHARS=4000

# 0 = cached results and pinned estimates never expire.
VALIDATION_CACHE_TTL_SECONDS=0

# Submitted estimate is accepted if within max(ABS hours, PCT of pinned estimate).
ESTIMATE_TOLERANCE_ABS_HOURS=2
ESTIMATE_TOLERANCE_PCT=0.20

# Insufficient-description check (CANNOT_VALIDATE_ESTIMATE).
# Minimum words in the description, and minimum meaningful words it must
# add beyond the task title.
MIN_DESCRIPTION_WORDS=5
MIN_DESCRIPTION_NEW_WORDS=4
